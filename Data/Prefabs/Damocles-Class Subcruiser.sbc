                    <TypeId>MyModStorageComponent</TypeId>
                    <Component xsi:type="MyObjectBuilder_ModStorageComponent">
                      <Storage>
                        <dictionary>
                          <item>
                            <Key>74de02b3-27f9-4960-b1c4-27351f2b06d1</Key>
                            <Value>[Whip's Block Renamer]
Number blocks=true
Number first block=true
Number with leading zeroes=true
Add space after prefixes=true
Add space before suffixes=true

;Missiles need: 1 RC/cockpit, 1 merge block (optionally a connector), atleast 1 gyro, atleast 1 battery, atleast 1 forward thruster, optionally 1 timer block, optionally 1 DetEq sensor
[MISSILE GUIDANCE SETTINGS]
;String in every block thats part of a missile
DefaultMissileTag=#C#
;Name of a group which contains every missile block. Only one group is needed.
MissileGroupName=Missile
;String in a missile's detach weapon, if any (compressed gas unit).
MissileDetachWeaponTag=Compressed Gas
;Maximum range before script detonates and discards missiles.
MaxRange=300000
;Game max speed.
MaxSpeed=2999
;Missile explodes when it is within this distance.
DefaultFuseDistance=7
;Distance missile travels before guiding.
LaunchDist=100
;Distance at which the missile goes into its terminal phase, activating a tagged timer block on the missile and its onboard sensor, if any.
TerminalDistance=15000
;DetEq Track Aggregator block name.
AggregatorBlockName=Detection IFF Aggregator
;LCD name where a list of DetEq targets and which one is selected is displayed.
TargetListLCDName=RadarReadout
;LCD ID, usually 0, could be 1 or 2 for things like cockpits.
TargetListLCDID=0
;Tag on any block the script should not use. Only applies to non missile blocks.
NoUseTag=NoUse
;Tag which all radars with a track radar has (track radar is defined as any angle with 1° aperture or less in the terminal menu.
TrackRadarString=Track
;Should the script consider grids without an IFF reflector valid targets.
ShowIFFlessTracks=false
;Should the script toggle ShowOnHud any track radars actively targeting something.
ShowOnHudTrackRadars=true
</Value>
                          </item>
                        </dictionary>
                      </Storage>
                    </Component>
                  </ComponentData>
                </Components>
