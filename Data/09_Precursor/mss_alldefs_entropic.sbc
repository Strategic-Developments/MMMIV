<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>mss_lg_t_entropic</SubtypeId>
			</Id>
			<DisplayName>Entropic Disintegrator</DisplayName>
			<Description>Entropic Disintegrators draw on the tremendous power of singularity-based energy systems to convert exotic matter into a particle stream directed with locally generated entropic force.</Description>
			<Icon>Textures\GUI\Icons\Cubes\EntropicDisintegrator.dds</Icon>
			<Public>true</Public>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="3" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\EntropicDisintegrator\EntropicDisintegrator.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="2000"/>
				<Component Subtype="Construction" Count="100"/>
				<Component Subtype="CoordsNetwork" Count="80">
					<DeconstructId>
						<TypeId>Ore</TypeId>
						<SubtypeId>Scrap</SubtypeId>
					</DeconstructId>
				</Component>
				<Component Subtype="Computer" Count="250"/>
				<Component Subtype="Construction" Count="200"/>
				<Component Subtype="SteelPlate" Count="600"/>
			</Components>
			<CriticalComponent Subtype="CoordsNetwork" Index="0"/>
			<MountPoints>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
			</MountPoints>
			<BlockPairName>mss_lg_t_entropic</BlockPairName>
			<MirroringY>Z</MirroringY>
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.144</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>200</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
		</Definition>
	</CubeBlocks>
</Definitions>