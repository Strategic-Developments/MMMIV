	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ThrustDefinition">
			<Id>
				<TypeId>Thrust</TypeId>
				<SubtypeId>LargeLeftPrecursorThrusterMeridian</SubtypeId>
			</Id>
			<DisplayName>Precursor Thruster, Sizable</DisplayName>
			<Description>Our technology is not yet advanced enough to get a read on this equipment.</Description>
			<Icon>Textures\GUI\Icons\PrecursorCore.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Public>false</Public> 
			<Size x="3" y="3" z="11"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\Precursor\LargeLeftPrecursorThrusterMeridian.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="50"/>
				<Component Subtype="Construction" Count="20"/>
				<Component Subtype="MetalGrid" Count="11"/>
				<Component Subtype="LargeTube" Count="4"/>
				<Component Subtype="SmallTube" Count="8"/>
				<Component Subtype="Motor" Count="8"/>
				 <Component Subtype="CoordsNetwork" Count="80">
                    <DeconstructId>
                        <TypeId>Ore</TypeId>
                        <SubtypeId>Scrap</SubtypeId>
                    </DeconstructId>
                </Component>
				<Component Subtype="Thrust" Count="100"/>
				<Component Subtype="MetalGrid" Count="10"/>
				<Component Subtype="SteelPlate" Count="10"/>
			</Components>
			<CriticalComponent Subtype="CoordsNetwork" Index="0"/>
			<MountPoints>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="11.00" EndY="3.00"/>
			</MountPoints>
			<BlockPairName>LargeLeftPrecursorThrusterMeridian</BlockPairName>
			<MirroringX>Z</MirroringX>
			<MirroringZ>Y</MirroringZ>
			<BuildTimeSeconds>20</BuildTimeSeconds>
			<EdgeType>Light</EdgeType>
			<ResourceSinkGroup>Thrust</ResourceSinkGroup>
			<ForceMagnitude>100000000</ForceMagnitude>
			<MaxPowerConsumption>8</MaxPowerConsumption>
			<MinPowerConsumption>0.000002</MinPowerConsumption>
			<SlowdownFactor>1</SlowdownFactor>
			<MinPlanetaryInfluence>0</MinPlanetaryInfluence>
			<MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
			<EffectivenessAtMinInfluence>1</EffectivenessAtMinInfluence>
			<EffectivenessAtMaxInfluence>0.2</EffectivenessAtMaxInfluence>
			<FlameDamageLengthScale>0.6</FlameDamageLengthScale>
			<FlameDamage>0.2</FlameDamage>
			<FlameLengthScale>2</FlameLengthScale>
			<FlameIdleColor>
				<X>1</X>
				<Y>0.1</Y>
				<Z>0.1</Z>
				<W>0.75</W>
			</FlameIdleColor>
			<FlameFullColor>
				<X>1</X>
				<Y>0.1</Y>
				<Z>0.1</Z>
				<W>0.75</W>
			</FlameFullColor>
			<FlamePointMaterial>EngineThrustMiddle</FlamePointMaterial>
			<FlameLengthMaterial>SciFiThrusterFlame</FlameLengthMaterial>
			<FlameFlare>LargeGridLargeThruster</FlameFlare>
			<FlameVisibilityDistance>3000</FlameVisibilityDistance>
			<FlameGlareQuerySize>1.5</FlameGlareQuerySize>
			<PrimarySound>SmShipLrgJet</PrimarySound>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>12</PCU>
			<TargetingGroups>
				<string>Propulsion</string>
			</TargetingGroups>
		</Definition>
