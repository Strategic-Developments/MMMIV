<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <CubeBlocks>
        <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
            <Id>
                <TypeId>Assembler</TypeId>
                <SubtypeId>mss_industrialreprocessor</SubtypeId>
            </Id>
            <DisplayName>Industrial Reprocessor</DisplayName>
            <Description>Designed to convert salvage and scrap into workable Modules, this is a must for any self-respecting industrialist.</Description>
            <Icon>Textures\GUI\Icons\Cubes\ChemicalRefinery.dds</Icon>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="2" z="3"/>
            <ModelOffset x="0" y="0" z="0"/>
            <Model>Models\Cubes\IndustrialReprocessor\ChemicalRefinery.mwm</Model>
            <Components>
                <Component Subtype="SteelPlate" Count="800"/>
                <Component Subtype="Construction" Count="120"/>
                <Component Subtype="LargeTube" Count="80"/>
                <Component Subtype="MetalGrid" Count="300"/>
                <Component Subtype="Computer" Count="400"/>
                <Component Subtype="PrototechCapacitor" Count="200"/>
                <Component Subtype="SteelPlate" Count="800"/>
            </Components>
            <CriticalComponent Subtype="PrototechCapacitor" Index="0"/>
            <MountPoints>
                <MountPoint Side="Front" StartX="0.00" StartY="0.13" EndX="1.00" EndY="1.87"/>
                <MountPoint Side="Back" StartX="0.00" StartY="0.09" EndX="1.00" EndY="1.91"/>
                <MountPoint Side="Left" StartX="0.06" StartY="0.10" EndX="2.94" EndY="1.90"/>
                <MountPoint Side="Right" StartX="0.05" StartY="0.08" EndX="2.95" EndY="1.92"/>
                <MountPoint Side="Top" StartX="0.00" StartY="0.14" EndX="1.00" EndY="2.86"/>
                <MountPoint Side="Bottom" StartX="0.00" StartY="0.07" EndX="1.00" EndY="2.93"/>
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.50" File="Models\Cubes\IndustrialReprocessor\ChemicalRefinery_BS1.mwm"/>
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\IndustrialReprocessor\ChemicalRefinery_BS2.mwm"/>
            </BuildProgressModels>
            <BlockPairName>mss_industrialreprocessor</BlockPairName>
            <MirroringY>Z</MirroringY>
            <MirroringZ>Y</MirroringZ>
            <BuildTimeSeconds>80</BuildTimeSeconds>
            <ResourceSinkGroup>Factory</ResourceSinkGroup>
            <InventoryMaxVolume>48</InventoryMaxVolume>
            <InventorySize>
                <X>1</X>
                <Y>1</Y>
                <Z>1</Z>
            </InventorySize>
            <StandbyPowerConsumption>0.01</StandbyPowerConsumption>
            <OperationalPowerConsumption>0.8</OperationalPowerConsumption>
            <BlueprintClasses>
                <Class>Industrial_Modules</Class>
            </BlueprintClasses>
            <IgnoredBlueprintClassesIcons>
                <IgnoredClassIcon>BuildPlanner</IgnoredClassIcon>
            </IgnoredBlueprintClassesIcons>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>BlockAssembler</PrimarySound>
            <ActionSound>BlockAssemblerProcess</ActionSound>
            <DestroyEffect>Explosion_Missile</DestroyEffect>
            <DestroySound>WepSmallMissileExpl</DestroySound>
            <PCU>40</PCU>
            <IsAirTight>true</IsAirTight>
            <TieredUpdateTimes>
                <unsignedInt>60</unsignedInt>
                <unsignedInt>120</unsignedInt>
                <unsignedInt>240</unsignedInt>
            </TieredUpdateTimes>
        </Definition>

        <Definition>
			<Id>
				<TypeId>CubeBlock</TypeId>
				<SubtypeId>KothStructure</SubtypeId>
			</Id>
			<DisplayName>{LOC:DisplayName_KothStructure}</DisplayName>
			<Description>{LOC:Description_KothStructure}</Description>
			<Icon>Textures\GUI\Icons\AstronautBackpack.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="145" y="17" z="145"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\KothStructure\KothStructure.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="4000"/>
                <Component Subtype="AdminKit" Count="10"/>
                <Component Subtype="SteelPlate" Count="4000"/>
			</Components>
			<CriticalComponent Subtype="AdminKit" Index="0"/>
			<BlockPairName>KothStructure</BlockPairName>
		</Definition>

        <Definition xsi:type="MyObjectBuilder_RefineryDefinition">
            <Id>
                <TypeId>Refinery</TypeId>
                <SubtypeId>LargeRefineryIndustrial</SubtypeId>
            </Id>
            <DisplayName>Industrial Uranium Processor</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\AdvancedRefinery.dds</Icon>
            <Description>This facility contains the necessary provisions to process, refine, and enrich uranium for usage aboard starship-grade reactors.</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="2" y="4" z="2"/>
            <ModelOffset x="0" y="0" z="0"/>
            <Model>Models\Cubes\Large\AdvancedRefinery.mwm</Model>
            <Components>
                <Component Subtype="SteelPlate" Count="1100"/>
                <Component Subtype="Construction" Count="40"/>
                <Component Subtype="LargeTube" Count="20"/>
                <Component Subtype="Motor" Count="16"/>
                <Component Subtype="PrototechCapacitor" Count="30"/>
                <Component Subtype="MetalGrid" Count="20"/>
                <Component Subtype="PrototechCircuitry" Count="20"/>
                <Component Subtype="Computer" Count="20"/>
                <Component Subtype="SteelPlate" Count="100"/>
            </Components>
            <CriticalComponent Subtype="Computer" Index="0"/>
            <Center x="1" y="0" z="1"/>
            <MountPoints>
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="2" EndY="4"/>
                <MountPoint Side="Bottom" StartX="0" StartY="1" EndX="2" EndY="2" Default="true"/>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1"/>
                <MountPoint Side="Bottom" StartX="1.5" StartY="0" EndX="2" EndY="1"/>
                <MountPoint Side="Top" StartX="0.8" StartY="0" EndX="2" EndY="1"/>
                <MountPoint Side="Top" StartX="0" StartY="0" EndX="0.8" EndY="0.1"/>
                <MountPoint Side="Top" StartX="0.1" StartY="1" EndX="1.9" EndY="1.7"/>
                <MountPoint Side="Top" StartX="0.4" StartY="1.7" EndX="1.7" EndY="1.9"/>
                <MountPoint Side="Left" StartX="1" StartY="0" EndX="2" EndY="2.1"/>
                <MountPoint Side="Left" StartX="0.4" StartY="3" EndX="2" EndY="3.9"/>
                <MountPoint Side="Left" StartX="1.8" StartY="2.1" EndX="2" EndY="3"/>
                <MountPoint Side="Left" StartX="0.2" StartY="0" EndX="1" EndY="0.7"/>
                <MountPoint Side="Left" StartX="0.2" StartY="1.1" EndX="0.8" EndY="1.4"/>
                <MountPoint Side="Right" StartX="0" StartY="0" EndX="1.4" EndY="1.1"/>
                <MountPoint Side="Right" StartX="1.4" StartY="0" EndX="2" EndY="0.5"/>
                <MountPoint Side="Right" StartX="0" StartY="1.1" EndX="0.4" EndY="3.3"/>
                <MountPoint Side="Right" StartX="0" StartY="3.3" EndX="1.7" EndY="3.9"/>
                <MountPoint Side="Right" StartX="0.4" StartY="2" EndX="2" EndY="2.1"/>
                <MountPoint Side="Front" StartX="1.2" StartY="0" EndX="1.8" EndY="0.7"/>
                <MountPoint Side="Front" StartX="1.2" StartY="1.1" EndX="1.8" EndY="1.4"/>
                <MountPoint Side="Front" StartX="0" StartY="2" EndX="1" EndY="2.1"/>
                <MountPoint Side="Front" StartX="0.3" StartY="3.3" EndX="1.6" EndY="3.9"/>
                <MountPoint Side="Front" StartX="0.8" StartY="3" EndX="1.6" EndY="3.3"/>
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="0.5" EndY="0.1"/>
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\AdvancedRefinery_Construction_1.mwm"/>
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\AdvancedRefinery_Construction_2.mwm"/>
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\AdvancedRefinery_Construction_3.mwm"/>
            </BuildProgressModels>
            <BlockPairName>RefineryIndustrial</BlockPairName>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>90</BuildTimeSeconds>
            <ResourceSinkGroup>Factory</ResourceSinkGroup>
            <InventoryMaxVolume>7.5</InventoryMaxVolume>
            <InventorySize>
                <X>2.5</X>
                <Y>2.5</Y>
                <Z>2.5</Z>
            </InventorySize>
            <InventoryFillFactorMin>0.3</InventoryFillFactorMin>
            <InventoryFillFactorMax>0.6</InventoryFillFactorMax>
            <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
            <OperationalPowerConsumption>0.56</OperationalPowerConsumption>
            <BlueprintClasses>
                <Class>Uranium_Reprocessing</Class>
            </BlueprintClasses>
            <RefineSpeed>20</RefineSpeed>
            <MaterialEfficiency>1.0</MaterialEfficiency>
            <OreAmountPerPullRequest>2000</OreAmountPerPullRequest>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <Center x="1" y="0" z="0"/>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>BlockRafinery</PrimarySound>
            <ActionSound>BlockRafineryProcess</ActionSound>
            <EmissiveColorPreset>Default</EmissiveColorPreset>
            <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>90</PCU>
            <TieredUpdateTimes>
                <unsignedInt>60</unsignedInt>
                <unsignedInt>120</unsignedInt>
                <unsignedInt>240</unsignedInt>
            </TieredUpdateTimes>
            <DLC>HeavyIndustry</DLC>
            <AllowSelfPulling>false</AllowSelfPulling>
        </Definition>
