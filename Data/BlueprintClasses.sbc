<?xml version="1.0"?>
 <Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema"> 

  


   <BlueprintClassEntries>
	

       <Entry Class="Components" BlueprintSubtypeId="SalvagedPlatingBP" />

      <Entry Class="ShipmentComponents" BlueprintSubtypeId="IssuedIngotShipmentBP" />
      <Entry Class="ShipmentComponents" BlueprintSubtypeId="TechIngotShipmentBP" />
      <Entry Class="ShipmentComponents" BlueprintSubtypeId="AdvancedIngotShipmentBP" />
      <Entry Class="ShipmentComponents" BlueprintSubtypeId="IngotShipmentBP" />

      <Entry Class="Industrial_Modules" BlueprintSubtypeId="IndustrialModuleBP" />
